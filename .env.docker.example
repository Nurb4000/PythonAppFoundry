# PythonAppFoundry Docker Environment Variables
# Copy this file to .env and customize for your deployment

# Application
APP_PORT=5000
APP_DEBUG=true

# Security — CHANGE THIS IN PRODUCTION!
SECRET_KEY=change-this-to-a-random-secure-string

# Database (SQLite default, or use PostgreSQL)
DATABASE_URL=sqlite:///instance/data.db

# PostgreSQL (uncomment to use instead of SQLite)
# DATABASE_URL=postgresql://appfoundry:changeme@db:5432/pythonappfoundry
# DB_USER=appfoundry
# DB_PASSWORD=changeme
# DB_NAME=pythonappfoundry

# LLM Configuration (optional, for AI module generation)
LLAMA_CPP_URL=http://llamacpp:8080
LLAMA_CPP_MODEL=
LLM_PROVIDER=llamacpp
LLM_ENDPOINT=http://llamacpp:8080
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=300

# Script Execution
SCRIPT_TIMEOUT=30

# SMTP Configuration (optional)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true

# IMAP Configuration (optional)
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL=5
IMAP_MARK_SEEN=false

# Site Configuration
SITE_NAME=PythonAppFoundry
